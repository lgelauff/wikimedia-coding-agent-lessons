#!/bin/bash
# pre-push — run this repo's deterministic drift guards before publishing.
#
# They check what a test suite structurally cannot: that the docs and the tree
# agree about each other, that bundled paths in skill bodies resolve, and that a
# plugin whose content changed carries a version bump. All three classes have
# shipped live bugs to this repo while every test passed.
#
# Install (once, from this repo):
#   git config core.hooksPath agent-tooling/git-hooks
#
# Setting that globally is fine: the hook resolves its guards from its OWN
# location and no-ops in any other repo, rather than blocking pushes there.
#
# Emergency bypass:
#   git push --no-verify

# Guards live beside this hook, not at the pushing repo's root — with a global
# core.hooksPath those are different places.
HOOK_DIR=$(cd "$(dirname "$0")" && pwd) || exit 1
GUARDS="$HOOK_DIR/../scripts"
GUARD_REPO=$(git -C "$HOOK_DIR" rev-parse --show-toplevel 2>/dev/null)
ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

# Pushing some other repo that merely shares this hooks path: not ours to police.
if [ -z "$ROOT" ] || [ "$ROOT" != "$GUARD_REPO" ]; then
    exit 0
fi

# Fail CLOSED, the lesson pre-commit already learned: a guard that skips itself
# when its interpreter is missing is a guard that silently does nothing.
if ! command -v python3 >/dev/null 2>&1; then
    if [ "$ALLOW_MISSING_PYTHON" = "1" ]; then
        echo "WARNING: python3 not found; drift guards skipped by explicit opt-out."
        exit 0
    fi
    echo "Push blocked: python3 is not available, so the drift guards cannot run." >&2
    echo "  Skip deliberately:  ALLOW_MISSING_PYTHON=1 git push ..." >&2
    exit 1
fi

# git hands the refs being pushed on stdin; read them once, before anything else can.
PUSH_REFS=$(cat)

STATUS=0

require() {
    if [ ! -f "$GUARDS/$1" ]; then
        echo "Push blocked: expected guard $1 is missing from $GUARDS." >&2
        STATUS=1
        return 1
    fi
}

# Exit 2 from any guard means "could not complete": unverified, not clean, so it
# blocks like a real failure.
require check_registration.py && { python3 "$GUARDS/check_registration.py" --root "$ROOT" --quiet || STATUS=1; }

# check_skill_vars.py takes skill roots as positional args; with none it discovers
# every skills/ tree in its own repo, which is $ROOT here.
require check_skill_vars.py && { python3 "$GUARDS/check_skill_vars.py" || STATUS=1; }

# check_version_bump.py has a different interface (--base/--plugin-dir) and must
# run from the repo root. conventions.md §7 requires it here: a plugin whose
# content changed without a bump reaches no consumer, silently.
if require check_version_bump.py; then
    ( cd "$ROOT" && python3 "$GUARDS/check_version_bump.py" )
    case $? in
        0) ;;
        2) # Could not complete — an unfetched base or a fork, not drift. Treat it
           # the way session-close treats exit 2: unverified is not the same as clean.
           echo "Push blocked: check_version_bump.py could not complete (exit 2)." >&2
           echo "  Usually an unfetched origin/main. Try: git fetch origin" >&2
           STATUS=1 ;;
        *) STATUS=1 ;;
    esac
fi

# This repo is public: what a push adds (lines and commit messages) must not carry
# private identifiers. Host names come from the LOCAL denylist in .git/info/, never
# from the tree. Exit 2 (could not complete) blocks like a finding.
if require check_public_text.py; then
    printf '%s\n' "$PUSH_REFS" | python3 "$GUARDS/check_public_text.py" --pre-push --root "$ROOT"
    case $? in
        0) ;;
        2) echo "Push blocked: check_public_text.py could not complete (exit 2)." >&2
           echo "  Usually an unfetched origin/main for a new branch. Try: git fetch origin" >&2
           STATUS=1 ;;
        *) STATUS=1 ;;
    esac
fi

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "Push blocked by a drift guard. Fix the problems above, or bypass with"
    echo "  git push --no-verify   (use with caution)"
fi
exit $STATUS
