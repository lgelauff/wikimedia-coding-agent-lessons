#!/bin/bash
# Global pre-commit hook — scans staged files for secrets using detect-secrets.
#
# If a .secrets.baseline file exists in the repo root, it is used to suppress
# known false positives. Create one with:
#   detect-secrets scan > .secrets.baseline
#
# To bypass in an emergency (use with caution):
#   git commit --no-verify

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
    exit 0
fi

# Fail CLOSED: a missing scanner previously let every commit through with only a
# warning, so the guard silently did nothing on any machine without detect-secrets.
if ! command -v detect-secrets-hook &>/dev/null; then
    if [ "$ALLOW_MISSING_DETECT_SECRETS" = "1" ]; then
        echo "WARNING: detect-secrets not found; scan skipped by explicit opt-out."
        exit 0
    fi
    echo "Commit blocked: detect-secrets is not installed, so staged files cannot" >&2
    echo "be scanned for credentials." >&2
    echo "  Install:            pipx install detect-secrets" >&2
    echo "  Skip deliberately:  ALLOW_MISSING_DETECT_SECRETS=1 git commit ..." >&2
    exit 1
fi

if [ -f ".secrets.baseline" ]; then
    detect-secrets-hook --baseline .secrets.baseline $STAGED
else
    detect-secrets-hook $STAGED
fi

STATUS=$?
if [ $STATUS -ne 0 ]; then
    echo ""
    echo "Commit blocked: potential secrets detected in staged files."
    echo "If this is a false positive, add it to .secrets.baseline:"
    echo "  detect-secrets scan > .secrets.baseline"
    echo "Then re-stage .secrets.baseline and commit again."
    echo "To bypass: git commit --no-verify (use with caution)"
fi
exit $STATUS
